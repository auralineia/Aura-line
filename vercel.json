{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "rimak": {
      "root": ".",
      "bindings": [
        {
          "type": "service",
          "service": "omniroute",
          "format": "url",
          "env": "OMNIROUTE_BASE_URL"
        }
      ]
    },
    "omniroute": {
      "root": "omniroute/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "rimak" } }
  ]
}