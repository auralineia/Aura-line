{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "rimak": {
      "root": "."
    },
    "omniroute": {
      "root": "omniroute/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "bindings": []
    }
  },
  "rewrites": [
    { "source": "/omniroute/(.*)", "destination": { "service": "omniroute" } },
    { "source": "/(.*)", "destination": { "service": "rimak" } }
  ]
}