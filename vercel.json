{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "rimak": {
      "root": ".",
      "bindings": [
        {
          "type": "service",
          "service": "omniroute",
          "format": "url",
          "env": "OMNIROUTE_BASE_URL"
        }
      ]
    },
    "omniroute": {
      "root": "omniroute/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat.js" },
    { "source": "/api/checkout", "destination": "/api/checkout.js" },
    { "source": "/api/checkout-config", "destination": "/api/checkout-config.js" },
    { "source": "/api/mercadopago-webhook", "destination": "/api/mercadopago-webhook.js" },
    { "source": "/api/payment", "destination": "/api/payment.js" },
    { "source": "/api/subscribe", "destination": "/api/subscribe.js" },
    { "source": "/(.*)", "destination": { "service": "rimak" } }
  ]
}